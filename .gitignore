# Dotfiles repo gitignore
# Patterns are evaluated from repo root.

## OS / editor junk
.DS_Store
*.swp
*.swo
*~

## Secrets (never commit these)
.env
.env.*
*.pem
*.key
id_rsa*
id_ed25519*

## Large generated / cache files
*.log
*.db
*.sqlite

## Spicetify AUR package clones (users should install via spicetify-cli + marketplace)
spicetify/Themes/catppuccin/
spicetify/Themes/themes-collection/
spicetify/Themes/Sleek/

## Spotify user-specific state (login tokens, per-machine hash folders)
## NOTE: if you prefer not to sync Spotify login state, uncomment the next line:
# spotify/

## GTK-4.0 theme symlinks (generated by catppuccin-gtk-theme package install)
## These point into /usr/share/themes and break on other machines.
gtk-4.0/assets
gtk-4.0/gtk.css
gtk-4.0/gtk-dark.css
