{
    "layer": "bottom",
    "position": "top",
    "margin-top": 10,
    "modules-left": [
        "idle_inhibitor",
        "mpris"
    ],
    "modules-center": [
        "clock",
        "hyprland/workspaces"
    ],
    "modules-right": [
        "tray",
        "custom/network-speed",
        "custom/controller",
        "pulseaudio",
        "custom/notification"
        // "custom/power"
    ],
    // LEFT MODULES
    "idle_inhibitor": {
        "format": "{icon}",
        "format-icons": {
            "activated": "☕",
            "deactivated": "󰣇"
        },
        "tooltip-format-activated": "Caffeine: ON",
        "tooltip-format-deactivated": "Caffeine: OFF",
        "on-click": "toggle"
    },
    "mpris": {
        "format": "{player_icon} {artist} | {title}",
        "format-paused": "{player_icon} {artist} | {title}",
        "format-stopped": "",
        "player-icons": {
            "spotify": "󰓇",
            "firefox": "󰈹",
            "zen": "󰈹",
            "brave": "󰊯",
            "google-chrome": "󰊯",
            "chromium": "󰊯",
            "vlc": "󰕼",
            "default": ""
        },
        "tooltip": false,
        "max-length": 45,
        "on-click-middle": "playerctl play-pause",
        "on-click": "playerctl volume 0.02-",
        "on-click-right": "playerctl volume 0.02+",
        "on-scroll-up": "playerctl previous",
        "on-scroll-down": "playerctl next",
        "escape": true
    },
    // CENTER MODULES
    "clock": {
        "format": " {:%I:%M %p}",
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
        "calendar": {
            "mode": "month",
            "mode-mon-col": 3,
            "weeks-pos": "right",
            "on-scroll": 1,
            "format": {
                "months": "<span color='#f5e0dc'><b>{}</b></span>",
                "days": "<span color='#cdd6f4'><b>{}</b></span>",
                "weeks": "<span color='#94e2d5'><b>W{}</b></span>",
                "weekdays": "<span color='#f9e2af'><b>{}</b></span>",
                "today": "<span color='#f38ba8'><b><u>{}</u></b></span>"
            }
        },
        "actions": {
            "on-click-right": "mode",
            "on-scroll-up": "shift_up",
            "on-scroll-down": "shift_down"
        }
    },
    "hyprland/workspaces": {
        "format": "{icon}",
        "format-icons": {
            "1": "󰚩",
            "2": "󰧑",
            "3": "󰘦",
            "4": "",
            "5": "󰨞",
            "6": "󰈹",
            "7": "󰙯",
            "8": "󰓇",
            "9": "",
            "default": "󰣇"
        },
        "persistent-workspaces": {
            "*": 9
        }
    },
    // RIGHT MODULES
    "tray": {
        "icon-size": 21,
        "spacing": 10,
        "icons": {
            // "TelegramDesktop": "telegram-symbolic",
            // "blueman": "bluetooth"
        }
    },
    "custom/network-speed": {
        "exec": "~/.config/waybar/scripts/network-speed.sh",
        "return-type": "json",
        "interval": 2,
        "format": "{}",
        "tooltip": true
    },
    "custom/controller": {
        "exec": "~/.config/waybar/scripts/controller-battery.sh",
        "return-type": "json",
        "signal": 8,
        "interval": 0
    },
    "pulseaudio": {
        "format": "{icon}  {volume}%",
        "format-bluetooth": "{icon}  {volume}%",
        "format-muted": "",
        "format-icons": {
            "alsa_output.pci-0000_00_1f.3.analog-stereo": "",
            "alsa_output.pci-0000_00_1f.3.analog-stereo-muted": "",
            "headphone": "",
            "hands-free": "",
            "headset": "",
            "phone": "",
            "phone-muted": "",
            "portable": "",
            "car": "",
            "default": [
                "",
                ""
            ]
        },
        "scroll-step": 1,
        "on-click": "pavucontrol",
        "ignored-sinks": [
            "Easy Effects Sink"
        ]
    },
    "custom/notification": {
        "tooltip": false,
        "return-type": "json",
        "exec-if": "command -v swaync-client",
        "exec": "swaync-client -swb",
        "on-click": "swaync-client -t",
        "on-click-right": "swaync-client -d",
        "on-click-middle": "swaync-client -C",
        "format": "{icon}",
        "format-icons": {
            "notification": "󰂚",
            "none": "󰂜",
            "dnd-notification": "󰂛",
            "dnd-none": "󰪑"
        }
    },
    "custom/power": {
        "format": "⏻",
        "tooltip": false,
        "on-click": "~/.config/rofi/powermenu.sh"
    }
}